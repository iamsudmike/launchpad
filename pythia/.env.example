# ── LLM backend ─────────────────────────────────────────────────────────────
# "openai" = local Ollama / any OpenAI-compatible endpoint (default: offline, free)
# "anthropic" = Claude (opt-in quality boost; requires ANTHROPIC_API_KEY)
LLM_PROVIDER=openai

# Local backend (LLM_PROVIDER=openai)
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_API_KEY=ollama
#LLM_MODEL=llama3.1

# Claude backend (LLM_PROVIDER=anthropic)
#ANTHROPIC_API_KEY=sk-ant-...
#ORACLE_MODEL=claude-opus-4-8       # main forecast reasoning
#SWARM_MODEL=claude-haiku-4-5       # persona re-scoring (~80% of tokens — keep cheap)
#CHAT_MODEL=claude-haiku-4-5        # /chat endpoint
#DEEP_MODEL=                        # e.g. claude-fable-5 — OFF by default; requires
                                    # 30-day data retention (see docs/claude-integration-plan.md)
#ORACLE_EFFORT=high                 # low | medium | high | xhigh | max
#ORACLE_THINKING=true               # adaptive thinking (recommended)
#ORACLE_CACHE=true                  # prompt caching on the world-snapshot prefix
#ORACLE_MIN_OUTPUT_TOKENS=8000      # output floor when thinking is on

# ── Cadence — THE cost lever with Claude ────────────────────────────────────
# Upstream default is 900 (15 min). Hourly keeps an Opus+Haiku loop ~$150-250/mo.
LOOP_INTERVAL_SEC=3600

# ── API security ────────────────────────────────────────────────────────────
# Required for remote mutating requests when the engine is exposed beyond
# localhost (see docs/security-hardening.md).
#PYTHIA_API_TOKEN=<long random string>
#CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#ENGINE_HOST=127.0.0.1              # bind loopback-only if you don't need LAN access
